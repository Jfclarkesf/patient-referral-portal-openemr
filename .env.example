# Copy this file to .env and fill in your values.
# The .env file is git-ignored and must never be committed.

# ── Database ──────────────────────────────────────────────
# Full connection string used by the app (Drizzle/Neon/pg).
DATABASE_URL=postgresql://user:password@localhost:5432/patient_referral
# Used by docker-compose to provision the bundled Postgres container.
POSTGRES_PASSWORD=your_secure_password_here

# Ports on the Synology. Pick free ones (3000, 5433 and 5434 are often taken).
APP_PORT=3001
DB_PORT=15432

# ── Sessions ──────────────────────────────────────────────
# Random 32+ character string used to sign session cookies.
SESSION_SECRET=your_random_session_secret_here

# ── App / deployment ──────────────────────────────────────
# Optional. Only used for OAuth redirects when OpenEMR is configured with the
# OPENEMR_* variables below instead of the setup wizard.
APP_DOMAIN=
APP_PROTOCOL=https
# Set to "true" for self-hosted username/password auth (non-Replit deployments).
STANDALONE_MODE=true
# Set to "true" when running behind a reverse proxy (nginx/Synology/etc).
TRUST_PROXY=true

# ── First admin ───────────────────────────────────────────
# Leave empty to create the admin in the browser: the first visit opens /setup.
# Set it only for unattended installs; it creates user "admin" with this password.
DEFAULT_ADMIN_PASSWORD=

# ── OpenEMR integration ───────────────────────────────────
# Optional. The setup wizard (/setup) registers this app with OpenEMR and stores
# the client in the database; that takes priority over these variables.
OPENEMR_BASE_URL=
OPENEMR_CLIENT_ID=
OPENEMR_CLIENT_SECRET=
# PEM-encoded private key for the OpenEMR OAuth client (keep on one line with \n, or load from a file).
OPENEMR_PRIVATE_KEY=your_openemr_private_key_here
# Optional OpenEMR defaults used when creating encounters.
OPENEMR_FACILITY_ID=
OPENEMR_PROVIDER_ID=
OPENEMR_ENCOUNTER_CATEGORY_ID=
# OpenEMR document category for files attached to referrals (default: /Medical Record).
OPENEMR_DOCUMENT_CATEGORY=

# ── Email notifications (Mailgun, optional) ───────────────
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=your_mailgun_domain_here
MAILGUN_FROM_EMAIL=noreply@your_mailgun_domain_here

# ── Object storage (optional / Replit) ────────────────────
# Leave unset to use the built-in mock object storage in development.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=
